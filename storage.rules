service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStudent() {
      return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    match /lessons/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && request.resource.size < 500 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
    }
    match /homework/{uid}/{file} {
      allow write: if isStudent() && request.auth.uid == uid && request.resource.size < 20 * 1024 * 1024;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
